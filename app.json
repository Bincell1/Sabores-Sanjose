{
  "expo": {
    "name": "Sabores San José",
    "slug": "sabores-san-jose",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "sabores",
    "splash": {
      "image": "./logo/logosisanjose.png",
      "imageWidth": 220,
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sabores.sanjose"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF6F0"
      },
      "package": "com.sabores.sanjose"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
